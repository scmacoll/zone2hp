# Zone Two — booking + accounts configuration (example).
# Copy to .env and adjust. .env is gitignored; never commit real values.
#
# The PUBLIC_* vars below are inlined into the static build and are NOT secret.
# Because the site is statically generated, changing one needs a rebuild.

# How /book renders:
#   mock      custom in-site UI driven by the built-in mock provider (default)
#   api       custom in-site UI driven by a real provider (needs a backend, not yet wired)
#   embedded  frames the provider's own hosted booking page (BookingEmbed)
PUBLIC_BOOKING_MODE=mock

# Which provider getBookingProvider() selects once a backend exists (mock | cliniko).
PUBLIC_BOOKING_PROVIDER=mock

# Hosted booking page URL, used by BookingEmbed when PUBLIC_BOOKING_MODE=embedded.
# This is Splose's PUBLIC online-booking link (not a secret), from
# Splose -> Settings -> Online bookings -> Share.
# e.g. https://zone-two-health-and-performance.splose.com/online-booking/<id>
PUBLIC_BOOKING_EMBED_URL=

# Show the Book now buttons and make /book reachable. OFF unless exactly "true".
PUBLIC_BOOKING_LINKS_VISIBLE=

# Show the Log in button and make /account and /api/account reachable. OFF
# unless exactly "true". Separate from booking on purpose, so the Splose booking
# embed can go live while accounts stay off.
PUBLIC_ACCOUNTS_ENABLED=

# Show the private-health-funding (HALTH-style) step in the booking funnel. On by
# default; set to false to remove the funding step entirely.
PUBLIC_BOOKING_FUNDING=true

# -----------------------------------------------------------------------------
# SERVER-ONLY secrets. Do NOT add a PUBLIC_ prefix (that would expose them to the
# browser). They are unused until a server runtime / serverless function exists
# to hold them; the static build never reads them. Never commit real values.
# -----------------------------------------------------------------------------

# Cliniko API key (HTTP Basic auth, broad access to patient data). Server-only.
CLINIKO_API_KEY=
# Cliniko region shard, e.g. au1, au2, au3, au4, uk1. Server-only.
CLINIKO_SHARD=

# --- Accounts (Supabase). See ACCOUNTS.md. ------------------------------------
# Create the project in the SYDNEY region (ap-southeast-2) so personal
# information stays in Australia, matching what /privacy tells patients.
#
# These hold NON-CLINICAL data only: name, email, contact preferences. No health
# information is ever stored here. Splose remains the system of record for
# anything clinical.
#
# With both of the first two unset the site falls back to the mock auth provider
# and the account pages stay in preview mode, so staging builds without secrets.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Anon / publishable key. Safe to use from the server with row level security on.
# Still server-only here: no PUBLIC_ prefix, so it is never inlined into the browser.
SUPABASE_ANON_KEY=
# Admin key. Bypasses row level security, so it must never reach a browser and is
# only needed for future admin tasks. Leave blank unless something requires it.
SUPABASE_SERVICE_ROLE_KEY=
