---
// Shared login / signup form. mode="login" | "signup". Non-clinical accounts:
// signup collects name, email, password and an unticked marketing opt-in only;
// no health fields (see ACCOUNTS.md).
//
// A real form POST to a server endpoint, which sets the httpOnly session cookie.
// It works with JavaScript disabled; the script below only adds inline
// validation so people are not round-tripped for a typo. The page owns the <h1>.
import { safeRedirect } from '../../lib/auth/redirect';

interface Props {
  mode: 'login' | 'signup';
  /** Server-rendered error from a failed attempt, passed back via the URL. */
  error?: string | null;
}

const { mode, error = null } = Astro.props;
const isSignup = mode === 'signup';
const action = isSignup ? '/api/account/signup' : '/api/account/signin';
const next = safeRedirect(Astro.url.searchParams.get('next'));
---

<div class="auth" data-auth-form data-mode={mode}>
  <form class="auth__form" method="POST" action={action} novalidate>
    <input type="hidden" name="next" value={next} />
    {
      error && (
        <p class="form-error" role="alert">
          {error}
        </p>
      )
    }
    {
      isSignup && (
        <div class="field">
          <label for="ac-name">Name</label>
          <input id="ac-name" name="name" type="text" autocomplete="name" required aria-describedby="ac-name-error" />
          <p class="field__error" id="ac-name-error" data-error="name" hidden />
        </div>
      )
    }
    <div class="field">
      <label for="ac-email">Email</label>
      <input id="ac-email" name="email" type="email" autocomplete="email" required aria-describedby="ac-email-error" />
      <p class="field__error" id="ac-email-error" data-error="email" hidden></p>
    </div>
    <div class="field">
      <label for="ac-password">Password</label>
      <input
        id="ac-password"
        name="password"
        type="password"
        autocomplete={isSignup ? 'new-password' : 'current-password'}
        required
        aria-describedby="ac-password-error"
      />
      <p class="field__error" id="ac-password-error" data-error="password" hidden></p>
    </div>
    {
      isSignup && (
        <label class="check">
          <input type="checkbox" name="marketing" />
          <span>
            Email me occasional updates and early access news from Zone Two. You can unsubscribe at any
            time.
          </span>
        </label>
      )
    }
    {
      isSignup && (
        <p class="privacy">
          We collect your name and email only. No health information is collected here. See our{' '}
          <a href="/privacy">Privacy Policy</a>.
        </p>
      )
    }
    <button type="submit" class="btn btn--solid" data-submit>{isSignup ? 'Create account' : 'Sign in'}</button>
  </form>
</div>

<script>
  // Progressive enhancement only. The form posts to the server either way; this
  // just catches obvious mistakes inline so a typo does not cost a round trip.
  // The server revalidates everything (see src/lib/auth/validate.ts).
  import { validateCredentials, validateSignUp } from '../../lib/auth/validate';

  const root = document.querySelector<HTMLElement>('[data-auth-form]');
  const form = root?.querySelector<HTMLFormElement>('form');

  if (root && form) {
    const mode = root.dataset.mode === 'signup' ? 'signup' : 'login';

    form.addEventListener('submit', (event) => {
      const data = new FormData(form);
      const errors =
        mode === 'signup'
          ? validateSignUp({
              name: String(data.get('name') ?? ''),
              email: String(data.get('email') ?? ''),
              password: String(data.get('password') ?? ''),
              marketingOptIn: data.get('marketing') === 'on',
            })
          : validateCredentials({
              email: String(data.get('email') ?? ''),
              password: String(data.get('password') ?? ''),
            });

      for (const field of ['name', 'email', 'password'] as const) {
        show(field, errors[field]);
      }

      if (Object.keys(errors).length > 0) {
        event.preventDefault();
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      // Let the POST proceed, but stop a second submit while it is in flight.
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
      if (submit) submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
    });

    function show(field: string, message: string | undefined): void {
      const input = form!.querySelector<HTMLInputElement>(`[name="${field}"]`);
      const error = form!.querySelector<HTMLElement>(`[data-error="${field}"]`);
      if (!input) return;
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) {
        error.hidden = !message;
        error.textContent = message ?? '';
      }
    }
  }
</script>

<style>
  .auth {
    max-width: 28rem;
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
  }
  .auth__form {
    display: grid;
    gap: var(--space-md);
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .field input {
    min-height: 44px;
    padding: 0.6rem 0.75rem;
    background: var(--paper);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--step-body);
    color: var(--ink);
  }
  .field input[aria-invalid='true'] {
    border-color: var(--accent-deep);
  }
  .field__error {
    margin: 0;
    color: var(--accent-deep);
    font-size: var(--step-small);
  }
  .check {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    color: var(--ink-2);
    font-size: var(--step-small);
    cursor: pointer;
  }
  .check input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    flex: none;
    accent-color: var(--accent-deep);
  }
  /* --ink-2, not --ink-3: ink-3 fails AA on paper (see PROGRESS.md). */
  .privacy {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step-small);
  }
  .form-error {
    margin: 0;
    color: var(--accent-deep);
    font-size: var(--step-small);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.875rem;
    padding-inline: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-out),
      border-color 150ms var(--ease-out);
  }
  .btn--solid {
    background: var(--accent-deep);
    color: var(--paper);
  }
  .btn--solid:hover {
    background: var(--accent-press);
  }
  .btn--solid:disabled {
    opacity: 0.6;
    cursor: default;
  }

</style>
