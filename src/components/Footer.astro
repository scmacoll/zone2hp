---
// Light footer: wordmark, address, contact, opening hours, copyright and links.
// Used by every white page (privacy, account, booking, Clinic Notes); the home
// page has its own FooterExpanded.
//   Narrow: one full-width, left-aligned column. Each group (address, hours,
//   contact, copyright and links) runs as a single line while it fits and wraps
//   only when it can't.
//   Wide: address, copyright and links on the left, dropped one line so the
//   street lines up with the phone; contact and hours on the right.
import Logo from "./Logo.astro";
import { openingHours } from "../lib/clinic";

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const email = "info@zone2hp.com";
const phoneDisplay = "0450 222 122";
const phoneHref = "tel:0450222122";
const year = 2026;
---

<footer class:list={["footer", className]}>
    <div class="footer__inner">
        <Logo variant="full" class="footer__logo" />

        <div class="footer__meta">
            <div class="footer__col footer__col--left">
                <address class="footer__address">
                    <span class="footer__keep">Suite 104, Level 1,</span> <span class="footer__keep">2 Rowe Street,</span> <br class="footer__br" /><span class="footer__keep">Eastwood, NSW 2122</span>
                </address>
                <div class="footer__legal">
                    <p class="footer__copy">&copy; {year} Zone Two Health and Performance</p>
                    <div class="footer__links">
                        <a class="footer__legal-link" href="/clinic-notes">Clinic notes</a>
                        <a class="footer__legal-link" href="/privacy">Privacy</a>
                    </div>
                </div>
            </div>

            <div class="footer__col footer__col--right">
                <div class="footer__contact">
                    <a href={`mailto:${email}`}>{email}</a>
                    <a href={phoneHref}>{phoneDisplay}</a>
                </div>
                <dl class="footer__hours" aria-label="Opening hours">
                    {
                        openingHours.map(([days, times]) => (
                            <div class="footer__hours-row">
                                <dt>{days}</dt>
                                <dd>
                                    {times.split(", ").map((t, i, all) => <span class="footer__session">{t}{i < all.length - 1 && <span class="footer__sep">,</span>}</span>)}
                                </dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </div>
    </div>
</footer>

<style>
    /* .footer is the query container; the blocks inside reflow on its width.
       All base rules come first, then the container queries at the end: a base
       rule placed after a query would win on source order and silently undo it. */
    .footer {
        container-type: inline-size;
        background: var(--stone);
        border-top: var(--border-hairline);
    }
    .footer__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-block: var(--space-lg);
        padding-inline: var(--section-pad-inline);
        display: grid;
        gap: var(--space-md);
        /* Left-aligned at every width: stacked lists and the hours table scan
           best from a shared left edge, and it matches the home footer. start,
           not stretch, because the logo is an SVG sized by height. */
        justify-items: start;
        text-align: left;
    }
    .footer__logo {
        --logo-height: clamp(24px, 1vw + 20px, 30px);
        color: var(--ink);
    }

    /* Narrow: the two column wrappers dissolve so their groups can stack in
       reading order: address, hours, contact, then copyright and links. */
    .footer__meta {
        justify-self: stretch;
        display: grid;
        gap: var(--space-sm);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink-2);
    }
    .footer__col {
        display: contents;
    }
    .footer__address {
        order: 1;
        font-style: normal;
    }
    .footer__br {
        display: none;
    }
    /* Address phrases stay whole, so a narrow footer wraps between them. */
    .footer__keep {
        white-space: nowrap;
    }
    .footer__hours {
        order: 2;
    }
    .footer__contact {
        order: 3;
    }
    .footer__legal {
        order: 4;
    }

    /* Days and sessions as a two-column table. Narrow: each day is one line
       ("9am–12pm, 2pm–6pm"). Wide: each session gets its own right-aligned
       line, so the times share one clean right edge. */
    .footer__hours {
        margin: 0;
        display: grid;
        grid-template-columns: max-content max-content;
        column-gap: 0.75rem;
        text-align: left;
    }
    .footer__hours-row {
        display: contents;
    }
    .footer__hours dt {
        color: var(--ink);
    }
    .footer__hours dd {
        margin: 0;
    }
    /* Narrow: sessions run on one line, separated by ", ". */
    .footer__session + .footer__session::before {
        content: " ";
    }

    /* Email and phone side by side, wrapping only when they can't share a
       line. Padding gives each a 44px hit area, negative margin cancels its
       height, so the links keep the address's line rhythm. */
    .footer__contact {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-md);
    }
    .footer__contact a {
        display: block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        font-family: var(--font-mono);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__contact a:hover {
        color: var(--accent-deep);
    }

    /* Copyright and links on one line, wrapping only when they can't share
       it. The gap between them is never narrower than the gap between the
       two links. */
    .footer__legal {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem var(--space-md);
    }
    .footer__copy {
        margin: 0;
    }
    .footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-md);
    }
    /* Same 44px hit area trick as the contact links. */
    .footer__legal-link {
        display: inline-block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__legal-link:hover {
        color: var(--accent-deep);
    }

    /* Wide: two columns. The left one drops a line so the street sits level
       with the phone number; everything runs at one tight step. */
    @container (min-width: 34rem) {
        .footer__meta {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: var(--space-xl);
        }
        .footer__col {
            display: grid;
            gap: 0.35rem;
        }
        .footer__col > * {
            order: 0;
        }
        .footer__col--left {
            justify-items: start;
            padding-top: 1.45rem;
        }
        .footer__col--right {
            justify-items: end;
        }
        .footer__br {
            display: inline;
        }
        .footer__contact {
            flex-direction: column;
            align-items: flex-end;
        }
        .footer__legal {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.35rem;
        }
        .footer__hours dd {
            text-align: right;
        }
        .footer__session {
            display: block;
        }
        .footer__session + .footer__session::before {
            content: none;
        }
        .footer__sep {
            display: none;
        }
    }

    /* Unselectable UI (see the selection policy in src/styles/global.css).
       Footer navigation. The email and phone links stay selectable. */
    .footer__legal-link {
        -webkit-user-select: none;
        user-select: none;
    }
</style>
