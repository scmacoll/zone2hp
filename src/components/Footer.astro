---
// Light footer: wordmark, address, contact, opening hours, copyright and links.
// Used by every white page (privacy, account, booking, Clinic Notes); the home
// page has its own FooterExpanded.
//   Contact details together on the left (address, email, phone), opening
//   hours on the right, and the legal line along the bottom (copyright left,
//   links right), the usual footer grouping and the same as the home footer.
import Logo from "./Logo.astro";
import { openingHours } from "../lib/clinic";

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const email = "info@zone2hp.com";
const phoneDisplay = "0450 222 122";
const phoneHref = "tel:0450222122";
const year = 2026;
---

<footer class:list={["footer", className]}>
    <div class="footer__inner">
        <Logo variant="full" class="footer__logo" />

        <div class="footer__meta">
            <div class="footer__col footer__col--left">
                <address class="footer__address">
                    <span class="footer__keep">Suite 104, Level 1,</span> <span class="footer__keep">2 Rowe Street,</span> <br /><span class="footer__keep">Eastwood,</span> <span class="footer__keep">NSW 2122</span>
                </address>
                <div class="footer__contact">
                    <a href={`mailto:${email}`}>{email}</a>
                    <a href={phoneHref}>{phoneDisplay}</a>
                </div>
            </div>

            <div class="footer__col footer__col--right">
                <dl class="footer__hours" aria-label="Opening hours">
                    {
                        openingHours.map(([days, times]) => (
                            <div class="footer__hours-row">
                                <dt>{days}</dt>
                                <dd>
                                    {times.split(", ").map((t, i, all) => <span class="footer__session">{t}{i < all.length - 1 && <span class="footer__sep">,</span>}</span>)}
                                </dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </div>

        <div class="footer__legal">
            <p class="footer__copy">&copy; {year} Zone Two Health and Performance</p>
            <div class="footer__links">
                <a class="footer__legal-link" href="/clinic-notes">Clinic notes</a>
                <a class="footer__legal-link" href="/privacy">Privacy</a>
            </div>
        </div>
    </div>
</footer>

<style>
    /* .footer is the query container; the blocks inside reflow on its width.
       All base rules come first, then the container query at the end: a base
       rule placed after a query would win on source order and silently undo it. */
    .footer {
        container-type: inline-size;
        background: var(--stone);
        border-top: var(--border-hairline);
    }
    .footer__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-block: var(--space-lg);
        padding-inline: var(--section-pad-inline);
        display: grid;
        gap: var(--space-md);
        /* start, not stretch: the logo is an SVG sized by height. */
        justify-items: start;
        text-align: left;
    }
    .footer__logo {
        --logo-height: clamp(24px, 1vw + 20px, 30px);
        color: var(--ink);
    }

    /* Two columns, everything at one line rhythm and one tight step. */
    .footer__meta {
        justify-self: stretch;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--space-md);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink-2);
    }
    .footer__col {
        display: grid;
        gap: 0.35rem;
    }
    .footer__col--left {
        min-width: 0;
        justify-items: start;
    }
    .footer__col--right {
        flex: none;
        justify-items: end;
    }

    .footer__address {
        font-style: normal;
    }
    /* Address phrases stay whole, so a narrow column wraps between them. */
    .footer__keep {
        white-space: nowrap;
    }

    /* Days and sessions as a two-column table; each session on its own line,
       right-aligned, so the times share one clean right edge. */
    .footer__hours {
        margin: 0;
        display: grid;
        grid-template-columns: max-content max-content;
        column-gap: 0.75rem;
        text-align: left;
    }
    .footer__hours-row {
        display: contents;
    }
    .footer__hours dt {
        color: var(--ink);
    }
    .footer__hours dd {
        margin: 0;
        text-align: right;
    }
    .footer__session {
        display: block;
    }
    .footer__sep {
        display: none;
    }

    /* Padding gives each link a 44px hit area, negative margin cancels its
       height, so the links keep the address's line rhythm. */
    .footer__contact {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .footer__contact a {
        display: block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        font-family: var(--font-mono);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__contact a:hover {
        color: var(--accent-deep);
    }

    /* Copyright left, links right; the gap between them never drops below
       the gap between the links, and the links wrap under it when needed. */
    .footer__legal {
        justify-self: stretch;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.35rem var(--space-md);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink-2);
    }
    .footer__copy {
        margin: 0;
    }
    .footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-md);
    }
    .footer__legal-link {
        display: inline-block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__legal-link:hover {
        color: var(--accent-deep);
    }

    /* Wide: the columns move further apart. */
    @container (min-width: 34rem) {
        .footer__meta {
            gap: var(--space-xl);
        }
    }

    /* Unselectable UI (see the selection policy in src/styles/global.css).
       Footer navigation. The email and phone links stay selectable. */
    .footer__legal-link {
        -webkit-user-select: none;
        user-select: none;
    }
</style>

