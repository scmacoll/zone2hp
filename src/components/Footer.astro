---
// Light footer: wordmark, address, contact, opening hours, copyright and links.
// Used by every white page (privacy, account, booking, Clinic Notes); the home
// page has its own FooterExpanded. Wide: address, copyright and links on the
// left; contact and hours on the right. Narrow: one centred stack.
import Logo from "./Logo.astro";
import { openingHours } from "../lib/clinic";

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const email = "info@zone2hp.com";
const phoneDisplay = "0450 222 122";
const phoneHref = "tel:0450222122";
const year = 2026;
---

<footer class:list={["footer", className]}>
    <div class="footer__inner">
        <Logo variant="full" class="footer__logo" />

        <div class="footer__meta">
            <address class="footer__address">
                Suite 104, Level 1, 2 Rowe Street,<br />Eastwood, NSW 2122
            </address>
            <dl class="footer__hours" aria-label="Opening hours">
                {
                    openingHours.map(([days, times]) => (
                        <div class="footer__hours-row">
                            <dt>{days}</dt>
                            <dd>
                                {times.split(", ").map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>
            <div class="footer__contact">
                <a href={`mailto:${email}`}>{email}</a>
                <a href={phoneHref}>{phoneDisplay}</a>
            </div>
            <p class="footer__copy">&copy; {year} Zone Two Health and Performance</p>
            <div class="footer__links">
                <a class="footer__legal-link" href="/clinic-notes">Clinic notes</a>
                <a class="footer__legal-link" href="/privacy">Privacy</a>
            </div>
        </div>
    </div>
</footer>

<style>
    /* .footer is the query container; the blocks inside reflow on its width.
       All base rules come first, then the container queries at the end: a base
       rule placed after a query would win on source order and silently undo it. */
    .footer {
        container-type: inline-size;
        background: var(--stone);
        border-top: var(--border-hairline);
    }
    .footer__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-block: var(--space-lg);
        padding-inline: var(--section-pad-inline);
        display: grid;
        gap: var(--space-md);
        /* Left-aligned at every width: stacked lists and the hours table scan
           best from a shared left edge, and it matches the home footer. start,
           not stretch, because the logo is an SVG sized by height. */
        justify-items: start;
        text-align: left;
    }
    .footer__logo {
        --logo-height: clamp(24px, 1vw + 20px, 30px);
        color: var(--ink);
    }

    /* Narrow: one left-aligned stack in reading order (address, hours, contact,
       copyright, links). */
    .footer__meta {
        display: grid;
        justify-items: start;
        gap: var(--space-sm);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink-2);
    }

    .footer__address {
        font-style: normal;
    }

    /* Days and sessions as a two-column table; each session on its own line,
       right-aligned, so the times share one clean right edge. */
    .footer__hours {
        margin: 0;
        display: grid;
        grid-template-columns: max-content max-content;
        column-gap: 0.75rem;
        text-align: left;
    }
    .footer__hours-row {
        display: contents;
    }
    .footer__hours dt {
        color: var(--ink);
    }
    .footer__hours dd {
        margin: 0;
        text-align: right;
    }
    .footer__hours dd span {
        display: block;
    }

    .footer__contact {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        /* No gap: the two links run on the same rhythm as the address lines. */
        gap: 0;
    }
    /* Padding gives a 44px hit area, negative margin cancels the visual height,
       so the tap target survives without opening a gap between the lines. */
    .footer__contact a {
        display: block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        font-family: var(--font-mono);
        font-size: var(--step-small);
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__contact a:hover {
        color: var(--accent-deep);
    }

    .footer__copy {
        margin: 0;
    }
    .footer__links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0 var(--space-md);
    }
    /* Same 44px hit area as the contact links (padding, cancelled by negative
       margin), so the links keep the footer's line rhythm. */
    .footer__legal-link {
        display: inline-block;
        padding-block: 0.6rem;
        margin-block: -0.6rem;
        line-height: 1.45rem;
        color: var(--ink);
        text-decoration: none;
    }
    .footer__legal-link:hover {
        color: var(--accent-deep);
    }

    /* Wide: address, copyright and links down the left; contact and hours down
       the right, all at one tight step. */
    @container (min-width: 34rem) {
        .footer__meta {
            justify-self: stretch;
            grid-template-columns: 1fr auto;
            grid-template-areas:
                "address contact"
                "copy    hours"
                "links   hours";
            /* The taller hours column spans the last two rows; its extra height
               goes to the flexible last row, so the links stay one step under
               the copyright instead of drifting down. */
            grid-template-rows: auto auto 1fr;
            gap: 0.35rem var(--space-xl);
            justify-items: start;
        }
        .footer__address {
            grid-area: address;
        }
        .footer__contact {
            grid-area: contact;
            justify-self: end;
            align-items: flex-end;
        }
        .footer__hours {
            grid-area: hours;
            justify-self: end;
        }
        .footer__copy {
            grid-area: copy;
        }
        .footer__hours {
            align-self: start;
        }
        .footer__links {
            grid-area: links;
            align-self: start;
            justify-content: flex-start;
        }
    }

    /* Unselectable UI (see the selection policy in src/styles/global.css).
       Footer navigation. The email and phone links stay selectable. */
    .footer__legal-link {
        -webkit-user-select: none;
        user-select: none;
    }
</style>
