---
// Closing block for the Clinic Notes pages: the client's Book online button
// with the consultations caption (address and phone are in the footer), and
// the general-information disclaimer. Styled by
// src/styles/clinic-notes.css (the .cn scope), so it only belongs on those pages.
//
// The Book button follows the same switch as every other booking link on the
// site: /book redirects home while PUBLIC_BOOKING_LINKS_VISIBLE is off, so the
// button would otherwise lead nowhere. The caption belongs to the button, so the
// two show or hide together.
import { bookingConfig } from '../lib/booking/config';
import { langFromUrl } from '../i18n/lang';
import { ui } from '../i18n/ui';
import { blog } from '../i18n/blog';

const lang = langFromUrl(Astro.url);
const t = blog[lang].close;
---

{
  bookingConfig.linksVisible && (
    <div class="cn-cta">
      <a class="cn-btn" href="/book">
        {ui[lang].bookOnline}
      </a>
      <p class="cn-cta__lang">
        {ui[lang].map.consultations[0]}<span lang="ko">한국어</span>{ui[lang].map.consultations[1]}
      </p>
    </div>
  )
}

<div class="cn-disclaimer">
  <p>{t.signature[0]}<span class="cn-keep">{t.signature[1]}</span></p>
  <p>{t.disclaimer}</p>
</div>
