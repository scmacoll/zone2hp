---
// Frames Cliniko's online booking page. Cliniko is the system of record for
// bookings, scheduling and patient data; nothing here touches patient data (see
// ACCOUNTS.md). Until PUBLIC_BOOKING_EMBED_URL is set this shows a factual
// placeholder and loads no third-party content.
import { bookingConfig } from '../lib/booking/config';

const url = bookingConfig.embedUrl;

const embedSrc = url
  ? `${url}${url.includes('?') ? '&' : '?'}embedded=true`
  : null;
---

<section class="embed" aria-label="Online booking">
  {
    url ? (
      <Fragment>
        <iframe
          id="cliniko-booking"
          class="embed__frame"
          src={embedSrc}
          title="Online booking"
          loading="lazy"
          scrolling="auto"
          allow="payment"
        />
        <p class="embed__fallback">
          If the booking page does not load, <a class="embed__link" href={url} target="_blank" rel="noopener noreferrer">open it in a new tab</a>.
        </p>
      </Fragment>
    ) : (
      <div class="embed__placeholder">
        <p class="embed__title">The online booking page will appear here.</p>
        <p class="embed__note">
          In embedded mode this frames the practice booking system's own page. Set
          <code>PUBLIC_BOOKING_EMBED_URL</code> to preview it.
        </p>
      </div>
    )
  }
</section>

<script>
  const frame = document.getElementById('cliniko-booking') as HTMLIFrameElement | null;

  if (frame) {
    window.addEventListener('message', (event) => {
      if (typeof event.data !== 'string') return;

      if (event.data.includes('cliniko-bookings-resize')) {
        const height = Number(event.data.split(':')[1]);
        if (Number.isFinite(height) && height >= 0) {
          frame.style.height = `${height}px`;
        }
      }

      if (event.data.includes('cliniko-bookings-page')) {
        frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>

<style>
  .embed {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
  }
  .embed__frame {
    width: 100%;
    min-height: 80svh;
    border: none;
  }
  .embed__fallback {
    margin: 0;
    margin-top: var(--space-sm);
    text-align: center;
    font-size: var(--step-small);
    color: var(--ink-2);
  }
  .embed__link {
    text-decoration: underline;
    color: var(--ink-2);
  }
  .embed__link:hover {
    color: var(--ink);
  }
  .embed__placeholder {
    display: grid;
    gap: var(--space-sm);
    place-content: center;
    text-align: center;
    min-height: 60svh;
    padding: var(--space-lg);
    border: 1px dashed var(--chrome-cool);
    border-radius: var(--radius-md);
    background: var(--grad-chrome);
  }
  .embed__title {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    color: var(--ink);
  }
  .embed__note {
    max-width: 44ch;
    margin-inline: auto;
    font-size: var(--step-small);
    color: var(--ink-2);
  }
  .embed__note code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    background: var(--chrome);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }
</style>
