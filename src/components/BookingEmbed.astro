---
// Frames Splose's own hosted booking page. Splose is the system of record for
// bookings, intake, consent and payment; nothing here touches patient data (see
// ACCOUNTS.md). Until PUBLIC_BOOKING_EMBED_URL is set this shows a factual
// placeholder and loads no third-party content.
import { bookingConfig } from '../lib/booking/config';
import CtaButton from './CtaButton.astro';

const url = bookingConfig.embedUrl;

// Splose's v2 embed reports its own height by postMessage so the frame can grow
// instead of scrolling internally.
const embedSrc = url
  ? `${url}${url.includes('?') ? '&' : '?'}embedVersion=v2`
  : null;
const embedOrigin = url ? new URL(url).origin : null;
---

<section class="embed" aria-label="Online booking">
  {
    url ? (
      <Fragment>
        <iframe
          id="splose-booking"
          class="embed__frame"
          src={embedSrc}
          title="Online booking"
          name="onlineBookingEmbeded"
          loading="lazy"
          scrolling="auto"
          data-embed-origin={embedOrigin}
        />
        <div class="embed__fallback">
          <p class="embed__fallback-text">If the booking page does not load</p>
          <CtaButton href={url} variant="outline" target="_blank" rel="noopener noreferrer">
            Open in new tab
          </CtaButton>
        </div>
      </Fragment>
    ) : (
      <div class="embed__placeholder">
        <p class="embed__title">The online booking page will appear here.</p>
        <p class="embed__note">
          In embedded mode this frames the practice booking system's own page. Set
          <code>PUBLIC_BOOKING_EMBED_URL</code> to preview it.
        </p>
      </div>
    )
  }
</section>

<script>
  const frame = document.getElementById('splose-booking') as HTMLIFrameElement | null;

  if (frame) {
    const allowedOrigin = frame.dataset.embedOrigin;

    window.addEventListener('message', (event) => {
      // Three checks, not one: the right frame, the right origin, and a shape we
      // recognise. Splose's published snippet only does the first.
      if (event.source !== frame.contentWindow) return;
      if (!allowedOrigin || event.origin !== allowedOrigin) return;

      const data = event.data;
      if (!data || typeof data.type !== 'string') return;

      if (data.type === 'sploseIframeResize') {
        const height = data.height;
        if (typeof height === 'number' && Number.isFinite(height) && height >= 0) {
          frame.style.height = `${height}px`;
        }
      } else if (data.type === 'sploseIframeScrollToTop') {
        frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>

<style>
  .embed {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
    padding-block: var(--space-lg);
  }
  .embed__frame {
    width: 100%;
    min-height: 70svh;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--stone);
  }
  /* Stacked and centred, with the button sized to sit with the line above it
     rather than reading as a stray inline link. */
  .embed__fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .embed__fallback-text {
    margin: 0;
    font-size: var(--step-body);
    color: var(--ink-2);
  }
  .embed__placeholder {
    display: grid;
    gap: var(--space-sm);
    place-content: center;
    text-align: center;
    min-height: 60svh;
    padding: var(--space-lg);
    border: 1px dashed var(--chrome-cool);
    border-radius: var(--radius-md);
    background: var(--grad-chrome);
  }
  .embed__title {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    color: var(--ink);
  }
  .embed__note {
    max-width: 44ch;
    margin-inline: auto;
    font-size: var(--step-small);
    color: var(--ink-2);
  }
  .embed__note code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    background: var(--chrome);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }
</style>
