---
import { bookingConfig } from '../lib/booking/config';
// Embedded map of the Eastwood address with the written address beside it.
// Keyless Google Maps embed (output=embed needs no API key). The block reflows
// from side-by-side to stacked on its own container width via a container query,
// which is the fix for the split-window case.
import Eyebrow from './Eyebrow.astro';

interface Props {
  class?: string;
  title?: string;
}

const { class: className = '', title = 'Eastwood, NSW' } = Astro.props;

const address1 = 'Suite 104, Level 1, 2 Rowe Street,';
const address2 = 'Eastwood, NSW 2122';
const query = 'Suite 104/2 Rowe St, Eastwood NSW 2122';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const directionsLink = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent('2 Rowe St, Eastwood NSW 2122')}`;
---

<section class:list={['map', className]} aria-labelledby="map-heading">
  <div class="map__grid">
    <div class="map__card">
      <div class="map__frame">
        <iframe
          title="Map showing Zone Two Health and Performance at Suite 104, Level 1, 2 Rowe Street, Eastwood, NSW 2122"
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <a class="map__directions" href={directionsLink} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M3 11 22 2l-9 19-2-8-8-2Z" fill="currentColor"></path>
        </svg>
        Get directions
      </a>
    </div>

    <div class="map__details">
      <Eyebrow>Find us in Eastwood</Eyebrow>
      <h2 id="map-heading" class="map__title">{title}</h2>
      <address class="map__address">
        {address1}<br />{address2}
      </address>
      {
        bookingConfig.linksVisible ? (
          <a class="map__book" href="/book">
            Book now
          </a>
        ) : (
          <button class="map__book" type="button" disabled aria-disabled="true">
            Book now
          </button>
        )
      }
    </div>
  </div>
</section>

<style>
  /* .map is the query container; .map__grid (its child) reflows on the
     block's own width, so it works full width or split in half. */
  .map {
    container-type: inline-size;
  }
  .map__grid {
    display: grid;
    gap: var(--space-md);
  }
  /* Stacked, the details lead so Book now comes before the map. */
  .map__details {
    order: -1;
  }

  @container (min-width: 38rem) {
    .map__grid {
      grid-template-columns: 1.5fr 1fr;
    }
    .map__details {
      order: 0;
      align-self: center;
    }
  }

  /* Map and Get directions are one object: the bar is the card's footer. */
  .map__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--chrome);
  }
  .map__frame {
    flex: 1;
  }
  .map__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    aspect-ratio: 16 / 10;
    border: 0;
  }
  .map__directions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1rem;
    background: var(--select);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    text-transform: none;
    transition: background-color 150ms var(--ease-out);
  }
  .map__directions:hover {
    background: var(--select-press);
  }
  /* The card clips overflow, so the ring sits inside the bar in white. */
  .map__directions:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -5px;
    box-shadow: none;
  }

  .map__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }
  .map__title {
    font-size: var(--step-h3);
  }
  .map__address {
    font-style: normal;
    color: var(--ink-2);
    line-height: 1.45;
  }
  /* Deliberately the same object as the header's Book now: same fill, label
     colour, radius, weight and height, so the two read as one control. */
  .map__book {
    margin-top: var(--space-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    min-height: 44px;
    padding: 0 1.15rem;
    background: var(--concept-volt, var(--accent-deep));
    color: var(--ink);
    border: 0;
    border-radius: var(--r-soft, var(--radius-sm));
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    /* text-transform inherits, and an ancestor sets uppercase. */
    text-transform: none;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out);
  }
  .map__book:hover {
    background: var(--concept-volt-press, var(--accent-press));
  }
  .map__book[disabled] {
    opacity: 0.55;
    cursor: default;
  }
</style>
