---
// Shell for one Clinic Notes post. The page supplies the client's copy:
//   default slot  the prose column
//   slot "side"   the In 30 seconds card, the figure and the See your GP box
//   slot "refs"   the <li> items of the references list
// Everything else (chrome, eyebrow, H1, standfirst, grid, CTA, disclaimer,
// links to the other posts, Article structured data) lives here.
//
// Styles are a plain stylesheet rather than a scoped <style>: slotted content
// carries the page's scope, not this layout's, and the SVG diagrams need the
// same rules. Everything in it sits under the .cn class.
import '../styles/clinic-notes.css';
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import ClinicNotesClose from '../components/ClinicNotesClose.astro';
import { getClinicNote, moreClinicNotes, noteText } from '../lib/clinic-notes';
import { hasTwin, langFromUrl, localise } from '../i18n/lang';
import { blog } from '../i18n/blog';

interface Props {
  slug: string;
}

// Rendered at /blog/<slug> and, once translated, /ko/blog/<slug> (the page
// supplies the prose in its language; this shell supplies the rest).
const lang = langFromUrl(Astro.url);
const t = blog[lang];
const note = getClinicNote(Astro.props.slug);
const post = { ...noteText(note, lang), slug: note.slug, datePublished: note.datePublished };
const others = moreClinicNotes(note.slug).map((n) => {
  const href = `/blog/${n.slug}`;
  return {
    ...noteText(n, lang),
    href: localise(lang, href),
    english: lang === 'ko' && !hasTwin(href),
  };
});

// Same computation as Base.astro's canonical, so the two always agree.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const image = Astro.site ? new URL('/images/og-zone2hp.png', Astro.site).href : '/images/og-zone2hp.png';

// Article only. No review or rating markup (s133 of the National Law, see
// COMPLIANCE.md). Author and publisher point at the nodes Base.astro declares.
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.heading,
  description: post.standfirst,
  datePublished: post.datePublished,
  dateModified: post.datePublished,
  image,
  inLanguage: lang === 'ko' ? 'ko' : 'en-AU',
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    '@id': 'https://zone2hp.com/#practitioner',
    name: 'Dr Mintae Kim',
    jobTitle: 'Chiropractor',
  },
  publisher: { '@id': 'https://zone2hp.com/#organization' },
};
---

<Base title={post.title} description={post.standfirst} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleData)} />
  <meta property="article:published_time" content={post.datePublished} slot="head" />

  <PageHeader />

  <main id="main" class="cn">
    <div class="cn-wrap cn-page">
      <nav class="cn-crumb" aria-label={t.post.breadcrumb}>
        <a href={localise(lang, '/blog')}><span aria-hidden="true">&larr;</span> {t.post.back}</a>
      </nav>

      <article class="cn-article">
        <div class="cn-eyebrow">
          <span class="cn-tag">{post.tag}</span><span>{post.readTime}</span>
        </div>
        <h1 class="cn-title">{post.heading}</h1>
        <p class="cn-stand">{post.standfirst}</p>

        <div class="cn-grid">
          <div class="cn-prose">
            <slot />
          </div>
          <div class="cn-side">
            <slot name="side" />
          </div>
        </div>

        <div class="cn-refs">
          <h2>{t.post.references}</h2>
          <ol>
            <slot name="refs" />
          </ol>
        </div>
      </article>

      <hr class="cn-trail" />

      <nav class="cn-more" aria-labelledby="cn-more-heading">
        <h2 id="cn-more-heading" class="cn-more__heading">{t.post.more}</h2>
        <ul class="cn-cards cn-cards--three">
          {
            others.map((n) => (
              <li>
                <a class="cn-card" href={n.href} hreflang={n.english ? 'en' : undefined}>
                  <small>
                    {n.tag}
                    {n.english && <span class="cn-en"> · {t.index.englishOnly}</span>}
                  </small>
                  <span class="cn-card__title">{n.cardTitle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ClinicNotesClose />
    </div>
  </main>

  <Footer />
</Base>
