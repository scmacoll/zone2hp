---
// One open role, built from src/lib/careers.ts, in the Clinic Notes post layout.
// The details panel takes the place of a post's side box, and its Apply button
// jumps to the form at the foot of the page.
import '../../styles/clinic-notes.css';
import '../../styles/careers.css';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import CareersForm from '../../components/CareersForm.astro';
import { roles, type Role } from '../../lib/careers';

export function getStaticPaths() {
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props as { role: Role };
---

<Base
  title={`${role.title}, ${role.location} | Zone Two Careers`}
  description={role.summary}
  noindex={role.draft}
>
  <PageHeader />

  <main id="main" class="cn cr cr-post">
    <div class="cn-wrap cn-page">
      <nav class="cn-crumb" aria-label="Breadcrumb">
        <a href="/careers"><span aria-hidden="true">&larr;</span> All open roles</a>
      </nav>

      <article class="cn-article">
        {role.draft && <p class="cr-role__draft">Sample role for staging only. This is not a real position.</p>}
        <div class="cn-eyebrow">
          <span class="cn-tag">Careers</span>
          <span>{role.location}</span>
        </div>
        <h1 class="cn-title">{role.title}</h1>
        <p class="cn-stand">{role.summary}</p>

        <div class="cn-grid">
          <div class="cn-prose cr-prose">
            {
              role.sections.map((section) => (
                <section>
                  <h2>{section.heading}</h2>
                  {section.paragraphs?.map((p) => <p>{p}</p>)}
                  {section.items && (
                    <ul>
                      {section.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </section>
              ))
            }
          </div>
          <aside class="cr-side" aria-label="Role details">
            <dl class="cr-facts">
              <div><dt>Location</dt><dd>{role.location}</dd></div>
              <div><dt>Type</dt><dd>{role.commitment}</dd></div>
            </dl>
            <a class="cn-btn" href="#apply">Apply for this role</a>
          </aside>
        </div>
      </article>

      <hr class="cn-trail" />

      <section class="cr-section" id="apply" aria-labelledby="cr-apply">
        <h2 class="cr-heading" id="cr-apply">Apply for this role</h2>
        <CareersForm role={role.title} />
      </section>
    </div>
  </main>

  <Footer />
</Base>
