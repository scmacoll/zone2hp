---
// One open role (English). The page lives in src/views/CareersRole.astro,
// shared with /ko/careers/<slug>.
import CareersRole from '../../views/CareersRole.astro';
import { roles, type Role } from '../../lib/careers';

export function getStaticPaths() {
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props as { role: Role };
---

<CareersRole role={role} />
