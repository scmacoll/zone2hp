---
// One open role, built from src/lib/careers.ts. The application form sits at
// the foot of the page, and the Apply button in the hero jumps to it.
import '../../styles/clinic-notes.css';
import '../../styles/careers.css';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import CareersForm from '../../components/CareersForm.astro';
import { roles, type Role } from '../../lib/careers';

export function getStaticPaths() {
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props as { role: Role };
---

<Base
  title={`${role.title}, ${role.location} | Zone Two Careers`}
  description={role.summary}
  noindex={role.draft}
>
  <PageHeader />

  <main id="main" class="cn cr">
    <header class="cn-hero">
      <div class="cn-wrap cn-hero__inner">
        <nav class="cn-crumb" aria-label="Breadcrumb"><a href="/careers"><span aria-hidden="true">&larr;</span> All open roles</a></nav>
        {role.draft && <p class="cr-role__draft">Sample role for staging only. This is not a real position.</p>}
        <h1 class="cn-hero__title">{role.title}</h1>
        <p class="cn-eyebrow">
          <span>{role.location}</span>
          <span>{role.commitment}</span>
        </p>
        <div><a class="cn-btn" href="#apply">Apply for this role</a></div>
      </div>
    </header>

    <div class="cn-wrap cr-body">
      <div class="cn-prose cr-prose">
        {
          role.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs?.map((p) => <p>{p}</p>)}
              {section.items && (
                <ul>
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <hr class="cn-trail" />

      <section class="cr-section" id="apply" aria-labelledby="cr-apply">
        <h2 class="cr-heading" id="cr-apply">Apply for this role</h2>
        <CareersForm role={role.title} />
      </section>
    </div>
  </main>

  <Footer />
</Base>
