---
// Careers: open roles as cards, then the expression-of-interest form, which
// stays useful when no role is open. Roles live in src/lib/careers.ts.
import '../../../styles/clinic-notes.css';
import '../../../styles/careers.css';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Footer from '../../../components/Footer.astro';
import CareersForm from '../../../components/CareersForm.astro';
import { roles } from '../../../lib/careers';
---

<Base
  title="Careers | Zone Two Health and Performance, Eastwood"
  description="Work with Zone Two Health and Performance in Eastwood, NSW. See our open roles or send an expression of interest."
>
  <PageHeader />

  <main id="main" class="cn cr">
    <header class="cn-hero">
      <div class="cn-wrap cn-hero__inner">
        <p class="cn-brand"><i aria-hidden="true"></i><span class="cn-brand__text"><span class="cn-keep">Zone Two Health and Performance</span><span class="cn-brand__sep" aria-hidden="true"> · </span><span class="cn-keep">Careers</span></span></p>
        <h1 class="cn-hero__title">Work<br /><span>with us</span></h1>
        <p class="cn-hero__intro">
          We provide chiropractic care, dry needling and exercise-based rehabilitation in Eastwood,
          NSW. See our open roles, or send us an expression of interest.
        </p>
      </div>
    </header>

    <div class="cn-wrap cr-body">
      <section class="cr-section" aria-labelledby="cr-roles">
        <h2 class="cr-heading" id="cr-roles">Open roles</h2>
        {
          roles.length > 0 ? (
            <ul class="cr-roles" role="list">
              {roles.map((r) => (
                <li>
                  <a class="cr-role" href={`/careers/${r.slug}`}>
                    {r.draft && <span class="cr-role__draft">Sample, staging only</span>}
                    <span class="cr-role__title">{r.title}</span>
                    <span class="cn-eyebrow">
                      <span>{r.location}</span>
                      <span>{r.commitment}</span>
                    </span>
                    <span class="cr-role__summary">{r.summary}</span>
                    <span class="cr-role__more">View role</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="cr-empty">No open roles right now. You're welcome to send an expression of interest below.</p>
          )
        }
      </section>

      <hr class="cn-trail" />

      <section class="cr-section" id="interest" aria-labelledby="cr-interest">
        <h2 class="cr-heading" id="cr-interest">Expression of interest</h2>
        <p class="cr-lead">
          We'd like to hear from registered practitioners and students. Tell us a little about yourself
          and we'll keep you in mind for future roles.
        </p>
        <CareersForm />
      </section>
    </div>
  </main>

  <Footer />
</Base>
