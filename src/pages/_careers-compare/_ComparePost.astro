---
// Alternative careers style, kept for reference. See README.md in this folder.
import '../../styles/clinic-notes.css';
import '../../styles/careers.css';
import './_compare.css';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import CareersForm from '../../components/CareersForm.astro';
import { roles } from '../../lib/careers';

const role = roles[0];
---

    <Base title="Role compare: post" noindex>
      <PageHeader />
      <main id="main" class="cn cr crv--post">
        <div class="cn-wrap cn-page">
          <nav class="cn-crumb" aria-label="Breadcrumb">
            <a href="/careers-compare/white"><span aria-hidden="true">&larr;</span> All open roles</a>
          </nav>

          <article class="cn-article">
            <p class="cr-role__draft">Sample role for staging only. This is not a real position.</p>
            <div class="cn-eyebrow">
              <span class="cn-tag">Careers</span>
              <span>{role.location}</span>
            </div>
            <h1 class="cn-title">{role.title}</h1>
            <p class="cn-stand">{role.summary}</p>

            <div class="cn-grid">
              <div class="cn-prose cr-prose">
                {role.sections.map((section) => (
                  <section>
                    <h2>{section.heading}</h2>
                    {section.paragraphs?.map((p) => <p>{p}</p>)}
                    {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
                  </section>
                ))}
              </div>
              <aside class="crv-side" aria-label="Role details">
                <dl class="crv-facts">
                  <div><dt>Location</dt><dd>{role.location}</dd></div>
                  <div><dt>Type</dt><dd>{role.commitment}</dd></div>
                </dl>
                <a class="cn-btn" href="#apply">Apply for this role</a>
              </aside>
            </div>
          </article>

          <hr class="cn-trail" />

          <section class="cr-section" id="apply" aria-labelledby="cr-apply">
            <h2 class="cr-heading" id="cr-apply">Apply for this role</h2>
            <CareersForm role={role.title} />
          </section>
        </div>
      </main>
      <Footer />
    </Base>
