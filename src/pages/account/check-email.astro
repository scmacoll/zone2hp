---
// Shown after signing up, when the address still needs confirming.
//
// Deliberately says nothing about whether the address was already registered.
// Someone signing up with an existing address lands here too, which is what
// stops the form being used to discover who has an account.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';

export const prerender = false;
---

<Base
  title="Confirm your email | Zone Two Health and Performance"
  description="Confirm your email address to finish setting up your Zone Two account."
  noindex
>
  <PageHeader />
  <main id="main" class="account">
    <header class="account__intro">
      <Eyebrow tone="accent">Account</Eyebrow>
      <h1 class="account__title">Check your email</h1>
      <p class="account__lede">
        If we can set up an account for that address, we have sent a confirmation link to it.
        Open the link to finish signing up.
      </p>
      <p class="account__note">
        Nothing arrived? Check the spam folder, or <a href="/account/signup">try again</a>.
      </p>
    </header>
  </main>
  <Footer />
</Base>

<style>
  .account__intro {
    max-width: 28rem;
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
    padding-block: var(--section-pad-block);
    display: grid;
    gap: var(--space-xs);
  }
  .account__title {
    margin: 0;
    font-size: var(--step-h2);
    letter-spacing: var(--track-tight);
  }
  .account__lede {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .account__note {
    margin: var(--space-xs) 0 0;
    font-size: var(--step-small);
    color: var(--ink-2);
  }
  .account__note a {
    color: var(--accent-deep);
  }
</style>
