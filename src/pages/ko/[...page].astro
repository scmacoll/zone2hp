---
// Korean pages (/ko/...). Each renders the same view as its English twin; the
// views read the language from the URL (src/i18n/lang.ts). Built only while
// koreanLive is on: staging and preview until Dr Kim signs the translation off,
// so production has no /ko/ pages at all rather than hidden ones. Keep this list
// in step with TRANSLATED in src/i18n/lang.ts.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import Home from '../../views/Home.astro';
import Faq from '../../views/Faq.astro';
import Careers from '../../views/Careers.astro';
import CareersRole from '../../views/CareersRole.astro';
import BlogIndex from '../../views/BlogIndex.astro';
import Privacy from '../../views/legal-ko/privacy.astro';
import DataSecurity from '../../views/legal-ko/data-security.astro';
import BookTypes from '../../views/book/BookTypes.astro';
import BookPatient from '../../views/book/BookPatient.astro';
import BookEmbedPage from '../../views/book/BookEmbedPage.astro';
import { bookingConfig } from '../../lib/booking/config';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { KOREAN_POSTS, koreanLive } from '../../i18n/lang';
import { roles, type Role } from '../../lib/careers';

type View = 'home' | 'faq' | 'careers' | 'role' | 'blog' | 'post' | 'privacy' | 'dataSecurity' | 'book' | 'bookPatient' | 'bookNew' | 'bookReturning';

// Korean Clinic Notes posts: one view per translated post, named by its slug.
const posts = import.meta.glob<{ default: AstroComponentFactory }>('../../views/blog-ko/*.astro', {
  eager: true,
});
const postView = (slug: string) => posts[`../../views/blog-ko/${slug}.astro`]?.default;

export function getStaticPaths() {
  if (!koreanLive) return [];
  return [
    { params: { page: undefined }, props: { view: 'home' as View } },
    { params: { page: 'faq' }, props: { view: 'faq' as View } },
    { params: { page: 'careers' }, props: { view: 'careers' as View } },
    { params: { page: 'blog' }, props: { view: 'blog' as View } },
    { params: { page: 'privacy' }, props: { view: 'privacy' as View } },
    { params: { page: 'privacy/data-security' }, props: { view: 'dataSecurity' as View } },
    // Booking: the Cliniko (embedded) path only, and only where booking is on.
    // /ko/book/refer renders on demand (src/pages/ko/book/refer.astro).
    ...(bookingConfig.linksVisible && bookingConfig.mode === 'embedded'
      ? [
          { params: { page: 'book' }, props: { view: 'book' as View } },
          { params: { page: 'book/patient' }, props: { view: 'bookPatient' as View } },
          { params: { page: 'book/new' }, props: { view: 'bookNew' as View } },
          { params: { page: 'book/returning' }, props: { view: 'bookReturning' as View } },
        ]
      : []),
    ...KOREAN_POSTS.map((slug) => ({ params: { page: `blog/${slug}` }, props: { view: 'post' as View, slug } })),
    ...roles.map((role) => ({
      params: { page: `careers/${role.slug}` },
      props: { view: 'role' as View, role },
    })),
  ];
}

const { view, role, slug } = Astro.props as { view: View; role?: Role; slug?: string };
const Post = view === 'post' && slug ? postView(slug) : undefined;
if (view === 'post' && !Post) throw new Error(`No Korean view for post: ${slug}`);
---

{view === 'home' && <Home />}
{view === 'faq' && <Faq />}
{view === 'careers' && <Careers />}
{view === 'role' && role && <CareersRole role={role} />}
{view === 'blog' && <BlogIndex />}
{view === 'privacy' && <Privacy />}
{view === 'dataSecurity' && <DataSecurity />}
{view === 'book' && <BookTypes />}
{view === 'bookPatient' && <BookPatient />}
{view === 'bookNew' && <BookEmbedPage kind="new" />}
{view === 'bookReturning' && <BookEmbedPage kind="returning" />}
{Post && <Post />}
