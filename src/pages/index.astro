---
// Concept A2 — owner-directed iteration on A1. Same Nivis-style template,
// addressing five things at once:
//   1) Panel is genuinely translucent (0.55) with stronger backdrop-blur so the
//      video bleeds through.
//   2) Volt is brighter and less brown: --concept-volt #FF8419, hue-shifted
//      from the Nivis lime keeping its energy.
//   3) Sharper corners across the board (2-4px) per the design system.
//   4) Z² mark next to the headline keeps the mark, drops the orange circle.
//   5) EN pill loses the globe and gets two vertical dots on the right, like
//      the Quechua lookbook ":" affordance.
// Typography: Archivo replaced with Geist (variable) for display and body on
// this page only, scoped to .a2 so it doesn't leak. The mono labels stay Geist
// Mono. Closer to the Nivis / Quechua reference grotesque than Archivo was.
import Base from "../layouts/Base.astro";
import ServicesLine from "../components/ServicesLine.astro";
import MapBlock from "../components/MapBlock.astro";
import FooterExpanded from "../components/FooterExpanded.astro";
import Logo from "../components/Logo.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { Image } from "astro:assets";
import portrait from "../assets/practitioners/mintae-kim.jpg";
import { bookingConfig } from "../lib/booking/config";
// Hero loop, re-encoded from the client's master (see brand/encode-hero.sh).
// FULL 30 second duration, silent. Only the codec and container changed: the
// master is HEVC/H.265, which Firefox cannot decode and Chrome only decodes with
// OS support, and it carried an audio track on a muted element. WebM first,
// H.264 as the universal fallback.
import videoWebm from "../asset/hero-loop.webm";
import videoMp4 from "../asset/hero-loop.mp4";
import videoPoster from "../asset/hero-poster.jpg";

// Owner asked for a single account button + a Book now CTA in the nav. Gated by
// the same flag that surfaces public booking/account links (now on by default).
const showBooking = bookingConfig.linksVisible;
const showAccounts = bookingConfig.accountsEnabled;
---

<Base
    title="About Dr Mintae Kim | Chiropractor Eastwood | Zone Two"
    description="Meet Dr Mintae Kim, chiropractor at Zone Two Health and Performance in Eastwood. Chiropractic care, rehabilitation and exercise focused on helping you move with confidence."
>
    <div class="a2">
        <main id="main">
            <section class="a2-hero">
                <div class="a2-hero__media" aria-hidden="true">
                    <video
                        class="a2-hero__video"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        poster={videoPoster.src ?? videoPoster}
                    >
                        <source src={videoWebm} type="video/webm" />
                        <source src={videoMp4} type="video/mp4" />
                    </video>
                </div>

                <div class="a2-hero__chrome">
                    <header class="a2-nav">
                        <a
                            class="a2-brand reveal reveal--d1"
                            href="#main"
                            aria-label="Zone Two Health and Performance, top of page"
                        >
                            <span class="a2-brand__full" aria-hidden="true">
                                <Logo variant="full" />
                            </span>
                            <span class="a2-brand__icon" aria-hidden="true">
                                <Logo variant="logotype" />
                            </span>
                        </a>

                        <div class="a2-actions">
                            <div
                            class="a2-lang-wrap reveal reveal--d2"
                            data-lang-current="en"
                        >
                            {/* Inert until Korean copy exists. It was a
                            <button> that responded to neither pointer nor
                            keyboard, which wastes a tab stop and fails WCAG
                            4.1.2, and it wrapped an invalid
                            listbox > option > button nesting. */}
                            <span class="a2-lang" lang="en">
                                <span
                                    class="a2-lang__label a2-lang__label--full"
                                    >English</span
                                >
                                <span
                                    class="a2-lang__label a2-lang__label--short"
                                    >En</span
                                >
                                <span class="a2-lang__sep" aria-hidden="true">
                                    <svg
                                        viewBox="0 0 4 14"
                                        width="6"
                                        height="21"
                                    >
                                        <circle
                                            cx="2"
                                            cy="5"
                                            r="1.2"
                                            fill="currentColor"></circle>
                                        <circle
                                            cx="2"
                                            cy="9"
                                            r="1.2"
                                            fill="currentColor"></circle>
                                    </svg>
                                </span>
                            </span>
                            </div>

                            <div class="a2-cta-group">
                            {
                                showAccounts && (
                                        <a
                                            class="a2-login reveal reveal--d3"
                                            href="/account/login"
                                            aria-label="Log in or create an account"
                                        >
                                            <svg
                                                class="a2-login__icon"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                aria-hidden="true"
                                            >
                                                <circle
                                                    cx="12"
                                                    cy="8.5"
                                                    r="3.5"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                />
                                                <path
                                                    d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                />
                                            </svg>
                                            <span class="a2-login__label">Log in</span>
                                        </a>
                                )
                            }
                                {
                                    showBooking ? (
                                        <a class="a2-book reveal reveal--d4" href="/book">
                                            <span class="a2-book__full">Book now</span>
                                            <span class="a2-book__short">Book</span>
                                        </a>
                                    ) : (
                                        <button
                                            class="a2-book reveal reveal--d4"
                                            type="button"
                                            disabled
                                            aria-disabled="true"
                                        >
                                            <span class="a2-book__full">Book now</span>
                                            <span class="a2-book__short">Book</span>
                                        </button>
                                    )
                                }
                            </div>
                        </div>
                    </header>

                    <div class="a2-panel reveal reveal--d5">
                        <div class="a2-panel__labels">
                            <ServicesLine class="a2-services" />
                        </div>

                        <p class="a2-slogan reveal reveal--d6">
                            <span class="a2-slogan__mark" aria-hidden="true">
                                <Logo variant="icon" />
                            </span>
                            <span class="a2-slogan__text"
                                >slow is <em>fast</em></span
                            >
                        </p>

                        <div class="a2-panel__main">
                            <div class="a2-panel__lead">
                            <h1
                                class="a2-headline reveal reveal--d7"
                            >
                                Modern<br />Chiropractic Therapy.
                            </h1>
                            </div>

                            <a
                                class="a2-discover reveal reveal--d8"
                                href="#about"
                            >
                                <span class="a2-discover__text uppercase"
                                    >See<br />more</span
                                >
                                <span
                                    class="a2-discover__arrow"
                                    aria-hidden="true"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="18"
                                        height="18"
                                        fill="none"
                                    >
                                        <path
                                            d="M12 5v14M6 13l6 6 6-6"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"></path>
                                    </svg>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <section id="about" class="a2-about" aria-labelledby="about-name">
                <p class="a2-about__slogan">
                    slowly is the fastest way to get to where you want to be
                </p>

                <div class="a2-about__grid">
                    <Image
                        class="a2-about__portrait"
                        src={portrait}
                        alt="Dr Mintae Kim, chiropractor at Zone Two Health and Performance"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 46rem) 20rem, 100vw"
                        loading="lazy"
                    />

                    <Eyebrow tone="accent" class="a2-about__eyebrow">About</Eyebrow>

                    <div class="a2-about__body">
                        <header class="a2-about__head">
                            <h2 class="a2-about__name" id="about-name">Dr Mintae Kim</h2>
                            <p class="a2-about__creds">
                                Chiropractor &middot; B.Chir.Sci., M.Chiro.
                            </p>
                        </header>

                        <div class="a2-about__prose">
                        <h3 class="a2-about__quote">A different approach to chiropractic care</h3>
                        <p>
                            At Zone Two Health and Performance in Eastwood, I believe good healthcare starts with trust.
                        </p>
                        <p>
                            My approach goes beyond simply helping you feel better today. It's about understanding what's holding you back, helping you move forward, and giving you the confidence to keep doing the things that matter to you.
                        </p>
                        <p>
                            Whether you're dealing with pain, recovering from an injury, or working towards better movement and performance, the goal is the same: meaningful progress that lasts.
                        </p>

                        <h3 class="a2-about__quote">
                            "Change is meant to be hard, and it takes time."
                        </h3>
                        <p>
                            Since graduating in 2019, my approach to chiropractic care has continued to evolve.
                        </p>
                        <p>
                            Early in my career, I was focused on understanding the "why", why people experience pain, why some problems keep returning, and why the same approach doesn't work for everyone.
                        </p>
                        <p>
                            Over time, I learned that meaningful change rarely comes from a quick fix. It comes from understanding the person in front of you, building trust, and working together towards something meaningful.
                        </p>
                        <p>
                            Trust isn't given. It's earned. That's the standard I want every person who walks through our doors to experience.
                        </p>

                        <details class="a2-about__more">
                            <summary aria-label="Read more about Dr Mintae Kim">
                                <span class="a2-about__summary-label">Read more</span>
                            </summary>

                            <h3 class="a2-about__quote">
                                "We do better in circles than in rows."
                            </h3>
                            <p>
                                I used to believe I needed to have all the answers and that doing things alone was the best way forward.
                            </p>
                            <p>
                                Experience taught me otherwise.
                            </p>
                            <p>
                                Great healthcare is collaborative. It means listening, asking better questions, sharing ideas, and recognising when someone else can add value to your care.
                            </p>
                            <p>
                                That philosophy shapes what we're building at Zone Two. Chiropractic, rehabilitation and exercise don't need to exist in isolation. When we work together and put the person at the centre of the conversation, we can make better decisions and create better outcomes.
                            </p>
                            <p>
                                Because being a lone wolf might get you there faster, but community takes you further.
                            </p>

                            <h3 class="a2-about__quote">"Celebrate the small wins."</h3>
                            <p>
                                Progress isn't always a straight line, and the biggest changes often start with small wins.
                            </p>
                            <p>
                                Getting out of pain can be one of those wins. Moving with more confidence can be another. Returning to the gym, getting back on the field, picking up your kids, or doing something you had started avoiding can mean even more.
                            </p>
                            <p>
                                For me, the real reward is being part of that journey.
                            </p>
                            <p>
                                It's not just about where you are today. It's about helping you overcome setbacks, build confidence in your body, and get back to doing more of what matters to you. That's the BIG win.
                            </p>

                            <h3 class="a2-about__quote">Chiropractic and rehabilitation in Eastwood</h3>
                            <p>
                                Zone Two Health and Performance provides chiropractic care, rehabilitation, exercise physiology and dry needling from our clinic in Eastwood, NSW.
                            </p>
                            <p>
                                Our approach is built around understanding you, your goals and how you move, then developing a plan to help you make meaningful progress.
                            </p>
                            <p>
                                If that sounds like the kind of healthcare you're looking for, we'd love to meet you.
                            </p>
                        </details>
                        </div>
                    </div>
                </div>
            </section>

            <section id="find-us" class="a2-find" aria-labelledby="find-us-heading">
                <h2 id="find-us-heading" class="a2-find__heading">Book an appointment</h2>
                <MapBlock />
            </section>
        </main>

        <FooterExpanded />
    </div>
</Base>

<style>
    /* Scope all token overrides to .a2 so they cascade into every descendant —
     reused components (ServicesLine, MapBlock, FooterExpanded) reskin without
     edits. */
    .a2 {
        /* Volt (hue-shifted from Nivis lime, same saturation + brightness). */
        --concept-volt: #ff8419;
        --concept-volt-press: #e66a0f;

        /* Hero grade fallback when no real video is present. */
        --grad-hero: var(--grad-hero-a1);

        /* Typography swap. Geist for display and body, mono untouched. */
        --font-display: "Geist Variable", Geist, system-ui, sans-serif;
        --font-body: "Geist Variable", Geist, system-ui, sans-serif;

        /* Sharper corners across the page (was 10-14px on A1). */
        --r-sharp: 2px;
        --m-soft: 8px;
        --r-soft: 6px;
    }

    /* ---- Hero ---------------------------------------------------------------- */
    .a2-hero {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        overflow: clip;
        isolation: isolate;
    }
    .a2-hero__media {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: var(--grad-hero);
    }
    .a2-hero__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        /* TEMP — heavy blur on the stock video while sharing with the owner so
           the licensed footage isn't recognisable. Scaled up slightly so the
           blur radius doesn't reveal transparent edges. Delete `filter` and
           `transform` to restore the real footage. */
        /*filter: blur(12px) saturate(115%);*/
        /*transform: scale(-1.15, 1.15);*/
        /* Cinema reveal: starts as a cropped box (set by --cinema-from), eases
           out to full screen, then holds. The from-state is a CSS variable so
           media queries can change it (landscape vs portrait) WITHOUT swapping
           animation-name — swapping animation-name restarts the animation on
           every resize across the breakpoint. With fill-mode: both, once the
           animation completes the element holds inset(0) and changing the
           variable has no visible effect (so resize is safe). */
        --cinema-from: inset(
            30% 14% 30% 14% round 18px
        ); /* landscape: wider cinema box (~2.9-3.4:1 on 16:10/9 displays), soft corners */
        animation: a2-hero-cinema 1000ms cubic-bezier(0.65, 0, 0.35, 1) both;
        will-change: clip-path;
    }

    @keyframes a2-hero-cinema {
        from {
            clip-path: var(--cinema-from);
        }
        to {
            clip-path: inset(0% 0% 0% 0% round 0);
        }
    }

    /* Mobile navbar background fade-in (<=47rem only). The translucent strip
       behind the nav used to be visible from page-load 0ms — beating the
       chrome reveals (brand at 1500ms, etc) to the screen. This keyframe
       starts transparent + no-blur, eases to its final translucent state at
       the same 1500ms mark the brand starts revealing, so the strip appears
       AS PART OF the chrome reveal sequence rather than before it. */
    @keyframes a2-navbar-reveal {
        from {
            background-color: transparent;
            border-color: transparent;
            -webkit-backdrop-filter: blur(0) saturate(100%);
            backdrop-filter: blur(0) saturate(100%);
        }
        to {
            background-color: rgba(15, 16, 19, 0.55);
            border-color: rgba(255, 255, 255, 0.08);
            -webkit-backdrop-filter: blur(16px) saturate(120%);
            backdrop-filter: blur(16px) saturate(120%);
        }
    }

    .a2-hero__chrome {
        position: relative;
        z-index: 1;
        min-height: inherit;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding: 2.66rem 1.33rem 1.33rem;
        transition: padding 350ms var(--ease-out);
    }
    /* At half-browser (~848px = 53rem) the panel's max-width (48rem) starts
       leaving a 40px gap to each viewport edge. Lift the chrome's side padding
       to 2.5rem (40px) at and above this threshold so the nav keeps the SAME
       40px gap as that point at every wider viewport. Below half-browser the
       chrome stays at 1.33rem so mobile doesn't waste space. The nav itself
       just fills the chrome content area (no max-width / margin-auto), so at
       wider viewports the header is genuinely wider than the panel while both
       align at exactly half-browser. */
    @media (min-width: 53rem) {
        .a2-hero__chrome {
            padding: 2.66rem 2.5rem 1.33rem;
        }
    }

    /* ---- Top bar: logo left, EN pill right -----------------------------------
       Only padding has a transition. The bg/border/backdrop are intentionally
       NOT transitioned — they appear/disappear in a single frame whenever the
       @media breakpoint flips. Transitioning them caused a perceived
       "background and outline arrive at different times" flicker during
       drag-resize because each property repaints on its own pass. */
    .a2-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        width: 100%;
        transition: padding 350ms var(--ease-out);
    }
    .a2-brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        /* The logo inherits this through currentColor. */
        color: var(--paper);
    }
    /* The full lockup carries the "Health and Performance" descriptor, which
       needs width to stay legible. Below the breakpoint further down we drop to
       the wordmark alone: the NAME must always be present, and the icon is
       already shown beside the headline just underneath. */
    .a2-brand__full {
        --logo-height: clamp(24px, 1.1vw + 20px, 32px);
        display: inline-flex;
    }
    .a2-brand__icon {
        --logo-height: clamp(14px, 1.6vw + 9px, 20px);
        display: none;
    }

    /* Language: a small, light TEXT toggle (no fill) so it reads as a quiet
       utility, not a button competing with the action pair. */
    .a2-lang {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 40px;
        padding: 0 0.25rem;
        background: transparent;
        color: var(--paper);
        border: 0;
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: color 150ms var(--ease-out);
    }
    .a2-lang:hover {
        color: var(--concept-volt);
    }
    .a2-lang__label {
        line-height: 1;
    }
    .a2-lang__sep {
        display: inline-flex;
        align-items: center;
        color: currentColor;
        opacity: 0.55;
    }

    .a2-lang-wrap {
        position: relative;
    }

    /* ---- Nav actions: account + book CTA (owner request) -------------------
       Synthesised from the references: one outlined secondary control (Log in,
       like the Nivis CART box) and one volt-filled primary CTA (Book now, like
       the Nivis SHOP box / Myo BOOK NOW). Both read on the dark video hero. */
    .a2-actions {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }
    /* The action pair (Log in + Book now) grouped tighter, separated from the
       quiet language toggle to its left. */
    .a2-cta-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .a2-login {
        display: inline-flex;
        align-items: center;
        text-align: center;
        white-space: nowrap;
        gap: 0.4rem;
        min-height: 44px;
        padding: 0 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: var(--r-soft);
        background: rgba(15, 16, 19, 0.28);
        color: var(--paper);
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        -webkit-backdrop-filter: blur(12px) saturate(120%);
        backdrop-filter: blur(12px) saturate(120%);
        transition:
            background-color 150ms var(--ease-out),
            border-color 150ms var(--ease-out);
    }
    .a2-login:hover {
        background: rgba(15, 16, 19, 0.45);
        border-color: rgba(255, 255, 255, 0.85);
    }
    .a2-login__icon {
        width: 18px;
        height: 18px;
        flex: none;
    }
    .a2-book {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        min-height: 44px;
        padding: 0 1.15rem;
        background: var(--concept-volt);
        color: var(--ink);
        border-radius: var(--r-soft);
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        transition: background-color 150ms var(--ease-out);
    }
    .a2-book:hover {
        background: var(--concept-volt-press);
    }
    .a2-book__short {
        display: none;
    }

    /* ---- Language dropdown menu --------------------------------------------
       Hidden by default; opens below the orange En/English button when the
       user clicks it. Style mirrors the panel + lang-wrap: translucent dark
       surface, backdrop-blur, soft corners. The orange button stays the
       "currently selected" affordance — the menu only lists alternatives. */
    .a2-lang__menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        min-width: 10rem;
        margin: 0;
        padding: 0.35rem;
        list-style: none;
        background: rgba(15, 16, 19, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--m-soft);
        -webkit-backdrop-filter: blur(20px) saturate(120%);
        backdrop-filter: blur(20px) saturate(120%);
        opacity: 0;
        transform: translateY(-0.4rem);
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 200ms var(--ease-out),
            transform 200ms var(--ease-out),
            visibility 0s linear 200ms;
        z-index: 5;
    }
    .a2-lang-wrap[data-open="true"] .a2-lang__menu {
        opacity: 1;
        transform: none;
        visibility: visible;
        pointer-events: auto;
        transition:
            opacity 200ms var(--ease-out),
            transform 200ms var(--ease-out),
            visibility 0s linear;
    }

    .a2-lang__option {
        display: block;
        width: 100%;
        min-height: 44px;
        padding: 0.55rem 0.85rem;
        background: transparent;
        color: var(--paper);
        border: 0;
        border-radius: 4px;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: background-color 150ms var(--ease-out);
    }
    .a2-lang__option:hover,
    .a2-lang__option:focus-visible {
        background: rgba(255, 255, 255, 0.08);
        outline: none;
    }
    .a2-lang__label--short {
        display: none;
    }
    .a2-lang__label--full {
        display: inline;
    }
    @media (max-width: 47rem) {
        .a2-lang__label--full {
            display: none;
        }
        .a2-lang__label--short {
            display: inline;
        }
    }

    /* ---- Dark, MORE translucent panel ---------------------------------------- */
    .a2-panel {
        container-type: inline-size;
        margin-top: auto;
        width: 100%;
        max-width: 48rem;
        min-height: 20rem;
        margin-inline: auto;
        display: flex; /* ADD */
        flex-direction: column; /* ADD */
        --ink-2: rgba(255, 255, 255, 0.7);
        --accent: var(--concept-volt);
        padding: clamp(1.25rem, 1rem + 1.4vw, 2rem);
        background: rgba(15, 16, 19, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--m-soft);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        backdrop-filter: blur(16px) saturate(120%);
        color: var(--paper);
        /* Smooth padding shrink at the mobile breakpoint. */
        transition: padding 350ms var(--ease-out);
    }
    .a2-panel__labels {
        padding-bottom: var(--space-sm);
        border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }
    .a2-panel :global(.a2-services) {
        font-size: var(--step-label);
    }

    .a2-panel.reveal {
        transform: translateY(70%);
        animation-duration: 1100ms;
    }

    .a2-panel__main {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        padding-top: var(--space-md);
        /* No auto margin: the SLOGAN carries it, so the two travel together. */
        margin-top: 0;
    }
    /* Keeps the slogan tied to the headline so the row layout further down stays
       a two-item flex (lead block, then the discover CTA). */
    .a2-panel__lead {
        min-width: 0;
    }
    @container (min-width: 34rem) {
        .a2-panel__main {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
            gap: var(--space-lg);
        }
    }

    /* The client's short slogan, kept lower case exactly as they wrote it. Sits
       above the headline as a quiet brand line rather than another uppercase
       label competing with the services row.

       Paper, not volt: the panel is 55% opaque over the video, so a bright frame
       lifts the effective background to roughly rgb(98,99,100), where volt falls
       to 2.5:1 against this 12.5px text. Paper stays at or above 4.5:1 across
       the whole range. It also sits brighter than the services row above, which
       is white at 0.7, so the slogan still reads as the emphasised line. */
    .a2-slogan {
        display: flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.55em;
        margin: auto 0 var(--space-sm);
        /* A floor against the services rule: while the panel has slack the auto
           margin absorbs this, and once it is content-driven this keeps the
           slogan off the rule instead of letting it sit on the line. */
        padding-top: var(--space-sm);
        font-family: var(--font-mono);
        font-size: var(--step-label);
        letter-spacing: var(--track-label);
        color: var(--paper);
    }
    .a2-slogan__mark {
        --logo-height: 1.5em;
        display: inline-flex;
        flex: none;
    }
    .a2-slogan em {
        font-style: italic;
        color: var(--concept-volt);
    }

    /* Geist tuned for the headline: medium-bold, tight tracking, near-1 leading.
     Replaces Archivo 800 expanded which was too inflated. */
    .a2-headline {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 600;
        /*font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.75rem);*/
        font-size: clamp(2rem, 1.15rem + 3.4vw, 3.75rem);
        /*font-size: clamp(1.5rem, 0.9rem + 2.4vw, 2.75rem);*/
        line-height: 0.96;
        letter-spacing: -0.025em;
        color: var(--paper);
    }

    /* ---- Discover CTA -------------------------------------------------------- */
    .a2-discover {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
        min-height: 44px;
        align-self: flex-start;
        padding: 0.8rem 1.05rem;
        background: var(--concept-volt);
        color: var(--ink);
        border-radius: var(--r-soft);
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        line-height: 1.2;
        transition:
            background-color 150ms var(--ease-out),
            padding 350ms var(--ease-out);
    }
    .a2-discover:hover {
        background: var(--concept-volt-press);
    }
    @container (min-width: 34rem) {
        .a2-discover {
            align-self: flex-end;
        }
    }
    .a2-discover__arrow {
        display: inline-flex;
    }

    /* ---- Find-us (map) section ---------------------------------------------- */

    /* ---- About --------------------------------------------------------------
       Container query, not a media query: the section reflows on its own width
       so it behaves in a half-width window (see DESIGN-SYSTEM.md). */
    .a2-about {
        container-type: inline-size;
        max-width: var(--container-max);
        margin-inline: auto;
        padding-block: var(--space-lg) 0;
        padding-inline: var(--section-pad-inline);
    }
    .a2-about__slogan {
        /* Equal air above and below, and tighter than the section's own padding:
           the slogan belongs to the About block, not floating between sections. */
        margin: 0 0 var(--space-lg);
        /* Full section width. It was capped at 22ch, which folded it onto two
           short lines well before the section ran out of room. */
        font-style: italic;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: clamp(1.5rem, 0.9rem + 2.4vw, 2.75rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        color: var(--ink);
        /* Not `balance`: balancing evens the line lengths, which is the other
           reason this was breaking early instead of running the full width. */
        text-wrap: pretty;
    }
    /* Three arrangements, driven by the section's own width so it behaves in a
       half-window as well as a full one.

       The middle one is the fix for a real gap: between roughly 480px and 736px
       the section was still fully stacked, which left the capped portrait sitting
       alone beside a column of dead space. Now the portrait pairs with the name
       block and the bio runs full width beneath it. */
    .a2-about__grid {
        display: grid;
        gap: var(--space-sm);
        align-items: start;
        grid-template-areas:
            "eyebrow"
            "head"
            "portrait"
            "prose";
    }
    /* Lets head and prose take part in the grid above rather than nesting. */
    .a2-about__body {
        display: contents;
    }
    .a2-about__portrait {
        grid-area: portrait;
    }
    .a2-about__head {
        grid-area: head;
    }
    .a2-about__prose {
        grid-area: prose;
    }
    .a2-about__eyebrow {
        grid-area: eyebrow;
        padding-bottom: var(--space-xs);
        border-bottom: var(--border-hairline);
    }

    /* The photo keeps its own aspect ratio: no aspect-ratio and no object-fit,
       so nothing is cropped. A 4:5 alternative crop is kept alongside it in
       src/assets/practitioners/ for comparison, but is not used. */
    .a2-about__portrait {
        width: 100%;
        height: auto;
        border-radius: var(--radius-md);
        background: var(--stone);
    }
    @container (min-width: 30rem) {
        .a2-about__portrait {
            max-width: 20rem;
        }
    }
    .a2-about__head {
        display: grid;
        gap: var(--space-2xs);
    }
    @container (min-width: 30rem) {
        .a2-about__grid {
            grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
            grid-template-areas:
                "eyebrow eyebrow"
                "portrait head"
                "prose prose";
            column-gap: var(--space-md);
            row-gap: var(--space-md);
        }
        .a2-about__head {
            align-self: center;
        }
    }

    @container (min-width: 46rem) {
        .a2-about__grid {
            grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
            grid-template-areas:
                "eyebrow eyebrow"
                "portrait head"
                "portrait prose";
            column-gap: var(--space-lg);
        }
        .a2-about__head {
            align-self: start;
        }
        .a2-about__portrait {
            position: sticky;
            top: var(--space-md);
        }
    }

    .a2-about__name {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--step-h3);
        letter-spacing: var(--track-tight);
        color: var(--ink);
    }
    .a2-about__creds {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--step-label);
        letter-spacing: var(--track-label);
        text-transform: uppercase;
        color: var(--ink-2);
    }
    .a2-about__quote {
        margin: var(--space-md) 0 var(--space-sm);
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--step-h3);
        line-height: 1.2;
        letter-spacing: var(--track-tight);
        color: var(--ink);
        /* Not balance: balancing evens the line lengths instead of filling the
           measure, which broke the quote early and left a gap down the right. */
        text-wrap: pretty;
    }
    /* The first quote sits directly under the credentials, where the grid gap
       already provides the separation, so its own top margin doubled it up. */
    .a2-about__prose > .a2-about__quote:first-child {
        margin-top: 0;
    }
    /* Scoped to .a2-about__prose so it reaches only the client's bio copy: a
       looser `.a2-about__body p` also caught the eyebrow and the credentials
       line and outranked their own styles. */
    .a2-about__prose p {
        margin: 0 0 var(--space-sm);
        font-size: var(--step-body);
        line-height: 1.65;
        color: var(--ink-2);
    }

    /* Disclosure for the rest of the bio: native <details>, so it needs no JS and
       stays keyboard accessible. The client's text is complete either way. */
    .a2-about__more {
        margin-top: var(--space-md);
    }
    /* The summary keeps a block display on purpose: giving <summary> a flex
       display breaks the native toggle in some WebKit versions, so the flex row
       lives on the inner label span instead. */
    .a2-about__more summary {
        display: block;
        cursor: pointer;
        list-style: none;
        color: var(--accent-deep);
    }
    .a2-about__more summary::-webkit-details-marker {
        display: none;
    }
    .a2-about__summary-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        font-family: var(--font-mono);
        font-size: var(--step-label);
        letter-spacing: var(--track-label);
        text-transform: uppercase;
    }
    /* Chevron drawn in CSS so the marker matches the label colour and rotates. */
    .a2-about__summary-label::after {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-25%) rotate(45deg);
        transition: transform 200ms var(--ease-out);
    }
    .a2-about__more[open] .a2-about__summary-label::after {
        transform: translateY(10%) rotate(-135deg);
    }
    .a2-about__more summary:focus-visible {
        outline: 2px solid var(--accent-deep);
        outline-offset: 3px;
    }
    /* One-way. Once the rest of the bio is open there is no way to fold it
       again: the control is removed rather than toggled. */
    .a2-about__more[open] summary {
        display: none;
    }
    @media (prefers-reduced-motion: reduce) {
        .a2-about__summary-label::after {
            transition: none;
        }
    }

    .a2-find {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-block: var(--section-pad-block);
        padding-inline: var(--section-pad-inline);
    }
    .a2-find__heading {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--step-h2);
        letter-spacing: var(--track-tight);
        color: var(--ink);
        margin-bottom: var(--space-md);
    }

    /* Subtle chrome glow on the map card: the map frame is already a --chrome
       surface, so the lit-from-above bloom reinforces its metallic quality and
       lifts it off the warm paper. Decoration only (box-shadow) — no contrast or
       layout impact. The inner highlight is hidden behind the opaque iframe; the
       soft outer bloom is what reads on the light page. */
    .a2-find :global(.map__frame) {
        box-shadow: var(--glow-chrome);
    }

    /* At mobile + half-laptop the MapBlock stacks (map on top, details below).
       By default the details are left-aligned and create a sparse left-leaning
       block with lots of empty space on the right. Centring the eyebrow, h2,
       address and the "Open in Google Maps" link gives the stack a balanced
       postcard look that mirrors the panel/footer treatment elsewhere. */
    @media (max-width: 47rem) {
        .a2-find :global(.map__details) {
            align-items: center;
            text-align: center;
        }
        .a2-find :global(.map__link),
        .a2-find :global(.map__book) {
            align-self: center;
        }
    }

    /* ---- Mobile / half-laptop reshuffle (matches the Nivis breakpoint) ------
       Below 47rem (~752px) — measured from nivisgear.com: the entire nav
       becomes the dark translucent strip (the lang button's own wrap goes
       transparent so we don't double-box); the panel padding tightens; the
       discover CTA stretches to the full panel width with the arrow pushed
       to the right; the services line lays out in a clean 2x2 grid with the
       separator dots hidden. Above 47rem reverts to the desktop layout above.
       Transitions on the affected elements make the snap feel like a slide
       when the browser is drag-resized across the breakpoint. */
    @media (max-width: 47rem) {
        .a2-nav {
            padding: 0.35rem 0.35rem 0.35rem 0.6rem;
            background: rgba(15, 16, 19, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: var(--m-soft);
            -webkit-backdrop-filter: blur(16px) saturate(120%);
            backdrop-filter: blur(16px) saturate(120%);
        }
        /* Only run the reveal animation on initial page load. Once .a2.is-revealed
           lands (~2.5s after load via the script), the animation no longer
           applies — any later resize across the breakpoint just snaps the strip
           on/off in a single frame via the @media rule above, no 1.5s delay
           replay, no per-property flicker. */
        .a2:not(.is-revealed) .a2-nav {
            animation: a2-navbar-reveal var(--reveal-duration, 700ms)
                var(--ease-out) 1500ms both;
        }
        .a2-lang-wrap {
            background: transparent;
            border: 0;
            padding: 0;
            -webkit-backdrop-filter: none;
            backdrop-filter: none;
        }
        /* Tighten the action cluster on the mobile strip: Log in shows text only
           (no icon), Book now shortens to "Book". */
        .a2-actions {
            gap: 0.5rem;
        }
        .a2-cta-group {
            gap: 0.4rem;
        }
        .a2-login {
            padding: 0 0.75rem;
            gap: 0;
        }
        .a2-login__icon {
            display: none;
        }
        .a2-book {
            padding: 0 0.85rem;
        }
        .a2-book__full {
            display: none;
        }
        .a2-book__short {
            display: inline;
        }
        .a2-panel {
            padding: 0.75rem;
            min-height: 18rem;
        }
        /* Portrait reveal start: a centred ~2:3 box (squarer than the previous
           tall strip), cropped on all four sides with soft rounded corners.
           Updating just the variable, not the animation-name, prevents the
           reveal from replaying when the user drags across the breakpoint. */
        .a2-hero__video {
            --cinema-from: inset(28% 18% 28% 18% round 18px);
        }
        /* Force the headline/CTA stack to stay vertical at mobile/half-laptop
           even when the panel's own container query would otherwise make it a
           row at >= 34rem panel width. CTA stretches full width of the panel. */
        .a2-panel__main {
            flex-direction: column;
            align-items: stretch;
        }
        .a2-discover {
            width: 100%;
            align-self: stretch;
            justify-content: space-between;
            padding: 1rem 1.05rem;
        }
        .a2-panel :global(.a2-services) {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.55rem 1rem;
        }
        .a2-panel :global(.a2-services .services__sep) {
            display: none;
        }
    }

    /* Video now plays at every viewport (the small-screen hide rule was
       removed). Reduced-motion still skips the cinema reveal and the
       navbar fade-in. */
    /* Below this the full lockup would crowd the nav actions, so the brand drops
       to the wordmark on its own. Never to the icon alone: the company name has
       to stay readable at every width. */
    @media (max-width: 37.5rem) {
        .a2-brand__full {
            display: none;
        }
        .a2-brand__icon {
            display: inline-flex;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .a2-nav {
            animation: none !important;
        }
        .a2-hero__video {
            display: none;
            animation: none;
            clip-path: inset(0);
        }
    }
</style>

<script>
    // The "read more" control is removed once the bio is open (one-way, by
    // design). That would otherwise strand a keyboard user, because focus dies
    // with the element it was on, so move focus onto the revealed copy.
    const bioDisclosure = document.querySelector<HTMLDetailsElement>('.a2-about__more');
    bioDisclosure?.addEventListener('toggle', () => {
        if (!bioDisclosure.open) return;
        const firstRevealed = bioDisclosure.querySelector<HTMLElement>('.a2-about__quote');
        if (!firstRevealed) return;
        firstRevealed.setAttribute('tabindex', '-1');
        firstRevealed.focus({ preventScroll: true });
    });
</script>

<script>
    // After the initial reveal sequence completes (~2.5s buffer), flag the
    // .a2 wrapper as revealed. Once flagged, the navbar's reveal animation is
    // dropped in favour of a simple opacity:1 — so any subsequent resize
    // across the 47rem breakpoint just tweens the opacity over 250ms,
    // instead of replaying the 1500ms-delayed reveal. This is what stops
    // the strip from flickering during drag-resize.
    const markRevealed = () =>
        document.querySelector(".a2")?.classList.add("is-revealed");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        markRevealed();
    } else {
        setTimeout(markRevealed, 2500);
    }

    // Language dropdown: toggle on button click, close on outside click /
    // Escape. The Korean option is a placeholder (no real translation wired
    // yet) — selecting it just closes the menu. When the Korean copy lands,
    // swap the option's onclick for a route change (Astro i18n: /ko/).
    document.addEventListener("DOMContentLoaded", () => {
        const wrap = document.querySelector(".a2-lang-wrap");
        if (!wrap) return;
        const button = wrap.querySelector(".a2-lang");
        const menu = wrap.querySelector(".a2-lang__menu");
        if (!button || !menu) return;
        // Paused: while the menu carries the `hidden` attribute we don't wire
        // any toggle behaviour, so clicking the En button is a no-op until
        // the dropdown is re-enabled.
        if (menu.hasAttribute("hidden")) return;

        const open = () => {
            wrap.dataset.open = "true";
            button.setAttribute("aria-expanded", "true");
        };
        const close = () => {
            delete wrap.dataset.open;
            button.setAttribute("aria-expanded", "false");
        };

        button.addEventListener("click", (e) => {
            e.stopPropagation();
            wrap.dataset.open === "true" ? close() : open();
        });

        menu.querySelectorAll(".a2-lang__option").forEach((opt) => {
            opt.addEventListener("click", (e) => {
                e.stopPropagation();
                // TODO: when Korean copy lands, switch route here
                // const lang = opt.dataset.lang;
                // if (lang === "ko") window.location.href = "/ko/";
                close();
            });
        });

        document.addEventListener("click", (e) => {
            if (!wrap.contains(e.target as Node)) close();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") close();
        });
    });
</script>
