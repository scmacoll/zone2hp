---
// Clinic Notes index: the client's contour-line hero and table of contents,
// then a short teaser for each post. Copy is the client's, verbatim, from
// zone-two-clinic-notes.html (the index description started as that file's meta
// description, widened to cover the round 2 posts, Nov 2026). Styles: src/styles/clinic-notes.css.
// Rendered at /blog and /ko/blog. On the Korean page, a post that has no Korean
// version yet links to the English one, marked 영문.
import '../styles/clinic-notes.css';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import ClinicNotesClose from '../components/ClinicNotesClose.astro';
import { clinicNotes, noteText } from '../lib/clinic-notes';
import { hasTwin, langFromUrl, localise } from '../i18n/lang';
import { blog } from '../i18n/blog';

const lang = langFromUrl(Astro.url);
const t = blog[lang].index;
const notes = clinicNotes.map((n) => {
  const href = `/blog/${n.slug}`;
  const english = lang === 'ko' && !hasTwin(href);
  return { ...noteText(n, lang), slug: n.slug, href: localise(lang, href), english };
});

// The zone 2 post keeps its card in the hero but has no teaser below.
const teasers = notes.filter((n) => n.slug !== 'zone-2-training');
---

<Base title={t.title} description={t.description}>
  <PageHeader />

  <main id="main" class="cn">
    <header class="cn-hero">
      <div class="cn-wrap cn-hero__inner">
        <p class="cn-brand"><i aria-hidden="true"></i><span class="cn-brand__text"><span class="cn-keep">Zone Two Health and Performance</span><span class="cn-brand__sep" aria-hidden="true"> · </span><span class="cn-keep">{t.place}</span></span></p>
        <h1 class="cn-hero__title">{t.heading[0]}<br /><span>{t.heading[1]}</span></h1>
        <p class="cn-hero__intro">{t.intro}</p>
        <nav aria-label={t.posts}>
          <ul class="cn-cards">
            {
              notes.map((n) => (
                <li>
                  <a class="cn-card" href={n.href} hreflang={n.english ? 'en' : undefined}>
                    <small>
                      {n.tag}
                      {n.english && <span class="cn-en"> · {t.englishOnly}</span>}
                    </small>
                    <span class="cn-card__title">{n.cardTitle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="cn-wrap cn-index">
      {
        teasers.map((n, i) => (
          <>
            <article class="cn-teaser">
              <div class="cn-eyebrow">
                <span class="cn-tag">{n.tag}</span>
                <span>{n.readTime}</span>
                {n.english && <span>{t.englishOnly}</span>}
              </div>
              <h2 class="cn-teaser__title">
                <a href={n.href} hreflang={n.english ? 'en' : undefined}>{n.heading}</a>
              </h2>
              <p class="cn-stand">{n.standfirst}</p>
            </article>
            {i < teasers.length - 1 && <hr class="cn-trail" />}
          </>
        ))
      }

      <ClinicNotesClose />
    </div>
  </main>

  <Footer />
</Base>
