---
// Gate page: new or existing patient, before the Cliniko booking embed. Shared
// by the English route (src/pages/book/patient.astro) and /ko/book/patient.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import { langFromUrl, localise } from '../../i18n/lang';
import { booking } from '../../i18n/booking';
import '../../styles/booking.css';

const lang = langFromUrl(Astro.url);
const t = booking[lang].patient;
---

<Base title={t.title} description={t.description} noindex>
  <PageHeader />
  <main id="main" class="book">
    <div class="gate">
      <h1 class="gate__title">{t.heading}</h1>
      <p class="gate__lede">{t.lede}</p>
      <div class="choices">
        <a class="choice" href={localise(lang, '/book/new')}>
          <span class="choice__title">{t.newTitle}</span>
          <span class="choice__blurb">{t.newBlurb}</span>
        </a>
        <a class="choice" href={localise(lang, '/book/returning')}>
          <span class="choice__title">{t.existingTitle}</span>
          <span class="choice__blurb">{t.existingBlurb}</span>
        </a>
      </div>
      <p class="gate__back"><a href={localise(lang, '/book')}>{t.back}</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .gate {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
    padding-block: var(--space-lg);
  }
  .gate__title {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
  }
  .gate__lede {
    margin-top: var(--space-2xs);
    color: var(--ink-2);
    max-width: 52ch;
  }
  .gate__back {
    margin-top: var(--space-md);
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  /* Unselectable UI (see the selection policy in src/styles/global.css). Back
     link. */
  .gate__back a {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
