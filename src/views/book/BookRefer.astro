---
// "Call or email to book" page for GPCCMP, third-party and NDIS funding types.
// Shared by the English route (src/pages/book/refer.astro) and
// src/pages/ko/book/refer.astro. Both render on demand: they read ?type=.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import { langFromUrl, localise } from '../../i18n/lang';
import { booking, bookingTypes } from '../../i18n/booking';

const lang = langFromUrl(Astro.url);
const t = booking[lang].refer;
const typeParam = Astro.url.searchParams.get('type') ?? '';
const fundingType = bookingTypes(lang).find((type) => type.id === typeParam);
---

<Base title={t.title(fundingType?.label)} description={t.description} noindex>
  <PageHeader />
  <main id="main">
    <div class="refer">
      <h1 class="refer__title">{t.heading(fundingType?.label)}</h1>
      <p class="refer__lede">{t.lede}</p>
      <div class="refer__contacts">
        <div class="refer__contact">
          <span class="refer__label">{t.phone}</span>
          <span class="refer__value"><a href="tel:0450222122">0450 222 122</a></span>
        </div>
        <div class="refer__contact">
          <span class="refer__label">{t.email}</span>
          <span class="refer__value"><a href="mailto:info@zone2hp.com">info@zone2hp.com</a></span>
        </div>
      </div>
      <p class="refer__back"><a href={localise(lang, '/book')}>{t.back}</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .refer {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-inline);
    padding-block: var(--space-lg);
  }
  .refer__title {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
  }
  .refer__lede {
    margin-top: var(--space-2xs);
    color: var(--ink-2);
    max-width: 52ch;
  }
  .refer__contacts {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    max-width: 28rem;
  }
  .refer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .refer__value a {
    color: var(--ink);
    text-decoration: underline;
  }
  .refer__value a:hover {
    color: var(--accent);
  }
  .refer__label {
    font-size: var(--step-small);
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .refer__value {
    font-size: var(--step-h4);
    font-family: var(--font-display);
  }
  .refer__back {
    margin-top: var(--space-md);
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  /* Unselectable UI (see the selection policy in src/styles/global.css). Field
     labels and the back link. The phone and email values stay selectable. */
  .refer__label,
  .refer__back a {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
